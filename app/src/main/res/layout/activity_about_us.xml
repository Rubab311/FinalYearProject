<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/about_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="IKHWA QURAN INSTITUTE"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Serving the Holy Quran Since 1999"
                android:textColor="@android:color/white"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- ================= ABOUT CARD ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F8F3"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/logo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="About Us"
                        android:textColor="#0D5C46"
                        android:textStyle="bold"
                        android:textSize="22sp" />

                </LinearLayout>

                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:background="#D4AF37" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="5dp"
                    android:text="Established in 1999, Ikhwa Quran Institute International has been committed to providing authentic Islamic education with sincerity and excellence. Through experienced teachers and a supportive learning environment, we offer online and on-campus programs for students of all ages. Our mission is to strengthen the connection of every student with the Holy Quran and Sunnah while nurturing strong Islamic character and values."
                    android:textColor="#555555"
                    android:textSize="15sp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ===== PART 1A ENDS HERE ===== -->

        <!-- Chairman Card will start in Part 1B -->
        <!-- ================= CHAIRMAN CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#F1F8F3"
                android:orientation="vertical"
                android:padding="20dp">



                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/chairman"
                    android:scaleType="centerCrop"
                    app:civ_border_width="3dp"
                    app:civ_border_color="#D4AF37"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Dr Muhammad Mustafa Jajja"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Founder and Chairman"
                    android:textSize="14sp"
                    android:textColor="#888888"/>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="#D4AF37"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Under the visionary leadership of our Chairman, Ikhwa Quran Institute has continued to provide authentic Islamic education and inspire students to develop a lifelong connection with the Holy Quran and Sunnah."
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= MANAGER CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="#F1F8F3"
                android:orientation="vertical"
                android:padding="20dp">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_marginTop="15dp"
                    android:src="@drawable/images"
                    android:scaleType="centerCrop"
                    app:civ_border_width="3dp"
                    app:civ_border_color="#D4AF37"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Manager Name"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#222222"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Institute Manager"
                    android:textSize="14sp"
                    android:textColor="#888888"/>

                <View
                    android:layout_width="50dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="#D4AF37"/>


            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ===== PART 1B ENDS HERE ===== -->
        <!-- ================= SENIOR TEAM CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F8F3"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senior Team"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D5C46"/>

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#D4AF37"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Senior 1 -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/images"
                            android:scaleType="centerCrop"
                            app:civ_border_width="2dp"
                            app:civ_border_color="#D4AF37"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Senior Name"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="16sp"/>



                    </LinearLayout>

                    <!-- Senior 2 -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="#F1F8F3"
                        android:orientation="vertical">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/images"
                            android:scaleType="centerCrop"
                            app:civ_border_width="2dp"
                            app:civ_border_color="#D4AF37"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Senior Name"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="16sp"/>


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>



        <!-- ================= EVENTS CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F8F3"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Institute Events"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D5C46"/>

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#D4AF37"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="220dp"
                            android:layout_height="140dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="5dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/logo"/>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="220dp"
                            android:layout_height="140dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="5dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/logo"/>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="220dp"
                            android:layout_height="140dp"
                            android:layout_marginStart="12dp"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="5dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/logo"/>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
        <!-- ================= MISSION CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F8F3"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Our Mission"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D5C46"/>

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#D4AF37"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="To provide authentic Islamic education, develop love for the Holy Quran and Sunnah, and nurture students with excellent character and strong moral values."
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= VISION CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F1F8F3"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Our Vision"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D5C46"/>

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#D4AF37"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Building a generation connected with the Quran, inspired by Islamic values, and prepared to serve society with knowledge and integrity."
                    android:textColor="#555555"
                    android:textSize="15sp"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= CONTACT CARD ================= -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/about_bg"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Us"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="#0D5C46"/>

                <View
                    android:layout_width="55dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="#D4AF37"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📞 +92 300 1234567"
                    android:textSize="16sp"
                    android:textColor="#444444"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="✉ info@ikhwa.org"
                    android:textSize="16sp"
                    android:textColor="#444444"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🌐 www.ikhwa.org"
                    android:textSize="16sp"
                    android:textColor="#444444"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="📍 Your Institute Address Here"
                    android:textSize="16sp"
                    android:textColor="#444444"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= FOOTER ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="© 2026 Ikhwa Quran Institute International\nAll Rights Reserved."
            android:textColor="#777777"
            android:textSize="13sp"/>

    </LinearLayout>

</ScrollView>